generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──── Enums ────

enum UserRole {
  OWNER
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FormStatus {
  PENDING
  SENT
  COMPLETED
  OVERDUE
}

enum MessageChannel {
  EMAIL
  SMS
  SYSTEM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum AutomationTrigger {
  NEW_CONTACT
  BOOKING_CREATED
  BEFORE_BOOKING
  FORM_PENDING
  INVENTORY_LOW
  STAFF_REPLY
}

enum WorkspaceStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
}

// ──── Models ────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(STAFF)
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])

  // Auth fields
  otpCode       String?
  otpExpires    DateTime?
  emailVerified DateTime?
  googleId      String?   @unique

  // Permissions
  canAccessInbox     Boolean @default(true)
  canAccessBookings  Boolean @default(true)
  canAccessForms     Boolean @default(true)
  canAccessInventory Boolean @default(true)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id             String          @id @default(cuid())
  name           String
  address        String?
  timezone       String          @default("UTC")
  contactEmail   String?
  contactPhone   String?
  status         WorkspaceStatus @default(ONBOARDING)
  onboardingStep Int             @default(1)

  // Email configuration
  emailProvider    String?
  emailApiKey      String?
  emailFromName    String?
  emailFromAddress String?
  emailConfigured  Boolean @default(false)

  // SMS configuration
  smsProvider   String?
  smsApiKey     String?
  smsFromNumber String?
  smsConfigured Boolean @default(false)

  // Relations
  users           User[]
  contacts        Contact[]
  services        Service[]
  bookings        Booking[]
  contactForms    ContactForm[]
  intakeForms     IntakeForm[]
  formSubmissions FormSubmission[]
  inventoryItems  InventoryItem[]
  conversations   Conversation[]
  automationRules AutomationRule[]
  automationLogs  AutomationLog[]
  alerts          Alert[]
  webhooks        Webhook[]
  integrationLogs IntegrationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id          String    @id @default(cuid())
  name        String
  email       String?
  phone       String?
  source      String    @default("form")
  notes       String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  bookings        Booking[]
  conversation    Conversation?
  formSubmissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, workspaceId])
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String?
  duration    Int // in minutes
  location    String?
  isActive    Boolean   @default(true)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  availableDays String @default("1,2,3,4,5")
  startTime     String @default("09:00")
  endTime       String @default("17:00")

  bookings       Booking[]
  linkedForms    IntakeForm[]
  inventoryLinks ServiceInventoryLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id          String        @id @default(cuid())
  date        DateTime
  endTime     DateTime
  status      BookingStatus @default(PENDING)
  notes       String?
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id])
  contactId   String
  contact     Contact       @relation(fields: [contactId], references: [id])
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])

  formSubmissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactForm {
  id             String    @id @default(cuid())
  name           String
  fields         String    @default("[]")
  isActive       Boolean   @default(true)
  slug           String    @unique @default(cuid())
  welcomeMessage String?
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntakeForm {
  id          String    @id @default(cuid())
  name        String
  description String?
  fields      String    @default("[]")
  isActive    Boolean   @default(true)
  slug        String    @unique @default(cuid())
  serviceId   String?
  service     Service?  @relation(fields: [serviceId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  submissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormSubmission {
  id           String      @id @default(cuid())
  data         String      @default("{}")
  status       FormStatus  @default(PENDING)
  intakeFormId String?
  intakeForm   IntakeForm? @relation(fields: [intakeFormId], references: [id])
  contactId    String
  contact      Contact     @relation(fields: [contactId], references: [id])
  bookingId    String?
  booking      Booking?    @relation(fields: [bookingId], references: [id])
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id])

  sentAt      DateTime?
  completedAt DateTime?
  dueDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryItem {
  id          String    @id @default(cuid())
  name        String
  description String?
  quantity    Int       @default(0)
  threshold   Int       @default(5)
  unit        String    @default("units")
  vendorName  String?
  vendorEmail String?
  vendorPhone String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  serviceLinks ServiceInventoryLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceInventoryLink {
  id          String        @id @default(cuid())
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id])
  inventoryId String
  inventory   InventoryItem @relation(fields: [inventoryId], references: [id])
  quantity    Int           @default(1) // quantity used per booking

  createdAt DateTime @default(now())

  @@unique([serviceId, inventoryId])
}

model Conversation {
  id            String    @id @default(cuid())
  subject       String?
  isActive      Boolean   @default(true)
  lastMessageAt DateTime  @default(now())
  unreadCount   Int       @default(0)
  contactId     String    @unique
  contact       Contact   @relation(fields: [contactId], references: [id])
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id             String           @id @default(cuid())
  content        String
  channel        MessageChannel   @default(EMAIL)
  direction      MessageDirection @default(OUTBOUND)
  isAutomated    Boolean          @default(false)
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  senderId       String?
  sender         User?            @relation(fields: [senderId], references: [id])

  createdAt DateTime @default(now())
}

model AutomationRule {
  id              String            @id @default(cuid())
  name            String
  trigger         AutomationTrigger
  isActive        Boolean           @default(true)
  messageTemplate String?
  delayMinutes    Int               @default(0)
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alert {
  id          String    @id @default(cuid())
  type        String
  title       String
  message     String
  isRead      Boolean   @default(false)
  actionUrl   String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
}

model Webhook {
  id          String            @id @default(cuid())
  url         String
  event       AutomationTrigger
  isActive    Boolean           @default(true)
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntegrationLog {
  id          String    @id @default(cuid())
  type        String // "email", "sms", "webhook", "calendar"
  status      String // "success", "failed", "bounced"
  to          String?
  message     String?
  error       String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
}

model AutomationLog {
  id          String            @id @default(cuid())
  ruleId      String
  trigger     AutomationTrigger
  status      String // "SUCCESS", "FAILED", "SKIPPED"
  details     String?
  recipient   String?
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
}
