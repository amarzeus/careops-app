# CareOps Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Option 1: Local PostgreSQL (Recommended for development)
# Start with: docker-compose up -d
DATABASE_URL="postgresql://careops:careops@localhost:5432/careops?schema=public"

# Option 2: SQLite (Fallback - not recommended for production)
# DATABASE_URL="file:./dev.db"

# Option 3: Render PostgreSQL (Production)
# DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# =============================================================================
# AUTHENTICATION
# =============================================================================

JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# =============================================================================
# AI SERVICES
# =============================================================================

# Gemini API Key (https://ai.google.dev/)
GEMINI_API_KEY=""

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================

# Option 1: Resend (Recommended - https://resend.com)
EMAIL_HOST="smtp.resend.com"
EMAIL_PORT="587"
EMAIL_USER="resend"
EMAIL_PASS="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"  # Your Resend API key
EMAIL_FROM="noreply@yourdomain.com"

# Option 2: Gmail
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT="587"
# EMAIL_USER="your-email@gmail.com"
# EMAIL_PASS="your-app-password"
# EMAIL_FROM="your-email@gmail.com"

# =============================================================================
# APP CONFIGURATION
# =============================================================================

NEXT_PUBLIC_APP_URL="http://localhost:5000"

# =============================================================================
# GOOGLE OAUTH (https://console.cloud.google.com/)
# =============================================================================

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# SMS CONFIGURATION (Twilio)
# =============================================================================

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# =============================================================================
# VOICE AI (VAPI - https://vapi.ai)
# =============================================================================

VAPI_API_KEY=""

# =============================================================================
# TESTING (Playwright)
# =============================================================================

BASE_URL=http://localhost:5000
TEST_ENV=local
API_URL=http://localhost:5000/api
