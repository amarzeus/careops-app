# CareOps Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="your-jwt-secret-here"

# AI (Gemini)
GEMINI_API_KEY=""

# Email (SMTP - Resend, Gmail, etc.)
EMAIL_HOST="smtp.resend.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="noreply@yourdomain.com"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMS - MSG91 (https://msg91.com)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_OTP_TEMPLATE_ID=""

# WhatsApp - MSG91 (https://msg91.com/whatsapp)
MSG91_WHATSAPP_INTEGRATED_NUMBER=""
MSG91_WHATSAPP_OTP_TEMPLATE_NAME=""

# SMS - Twilio (legacy fallback)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Playwright Tests
BASE_URL=http://localhost:3000
TEST_ENV=local
API_URL=http://localhost:3000/api
