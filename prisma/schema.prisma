generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──── Enums ────

enum UserRole {
  OWNER
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FormStatus {
  PENDING
  SENT
  COMPLETED
  OVERDUE
}

enum MessageChannel {
  EMAIL
  SMS
  WHATSAPP
  SYSTEM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum AutomationTrigger {
  NEW_CONTACT
  BOOKING_CREATED
  BEFORE_BOOKING
  FORM_PENDING
  INVENTORY_LOW
  STAFF_REPLY
}

enum WorkspaceStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
}

// ──── Models ────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(STAFF)
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id])

  // Auth fields
  otpCode       String?
  otpExpires    DateTime?
  otpChannel    String?   // "email", "sms", "whatsapp" — which channel last OTP was sent on
  emailVerified DateTime?
  googleId      String?   @unique
  phone         String?
  phoneVerified DateTime?

  // Permissions
  canAccessInbox     Boolean @default(true)
  canAccessBookings  Boolean @default(true)
  canAccessForms     Boolean @default(true)
  canAccessInventory Boolean @default(true)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id           String          @id @default(cuid())
  name         String
  address      String?
  timezone     String          @default("UTC")
  contactEmail String?
  contactPhone String?
  status       WorkspaceStatus @default(ONBOARDING)
  onboardingStep Int           @default(1)

  // Email configuration
  emailProvider    String?
  emailApiKey      String?
  emailFromName    String?
  emailFromAddress String?
  emailConfigured  Boolean @default(false)

  // SMS configuration
  smsProvider   String?
  smsApiKey     String?
  smsFromNumber String?
  smsConfigured Boolean @default(false)

  // WhatsApp configuration
  whatsappProvider         String?
  whatsappIntegratedNumber String?
  whatsappConfigured       Boolean @default(false)

  // Google Calendar integration
  googleCalendarConnected     Boolean  @default(false)
  googleCalendarAccessToken   String?
  googleCalendarRefreshToken  String?
  googleCalendarTokenExpiry   DateTime?
  googleCalendarEmail         String?
  googleCalendarId            String?  @default("primary")

  // Relations
  users           User[]
  contacts        Contact[]
  services        Service[]
  bookings        Booking[]
  contactForms    ContactForm[]
  intakeForms     IntakeForm[]
  formSubmissions FormSubmission[]
  inventoryItems  InventoryItem[]
  inventoryLogs   InventoryLog[]
  conversations   Conversation[]
  automationRules AutomationRule[]
  alerts          Alert[]
  webhooks        Webhook[]
  integrationLogs IntegrationLog[]
  webhookDeliveries WebhookDeliveryLog[]
  voiceCalls      VoiceCall[]
  voiceAgents     VoiceAgent[]
  phoneNumbers   PhoneNumber[]
  aiPreferences  AIPreferences?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Webhook {
  id          String            @id @default(cuid())
  url         String
  event       AutomationTrigger
  secret      String?           // HMAC secret for signature verification
  isActive    Boolean           @default(true)
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  deliveries  WebhookDeliveryLog[]
  createdAt   DateTime          @default(now())
}

model WebhookDeliveryLog {
  id           String    @id @default(cuid())
  webhookId    String
  webhook      Webhook   @relation(fields: [webhookId], references: [id])
  status       String    // SUCCESS, FAILED, PENDING_RETRY
  statusCode   Int?
  responseBody String?
  error        String?
  requestBody  String?   // Store the payload for debugging
  signature    String?   // Store the signature used
  retryCount   Int       @default(0)
  retryAt      DateTime? // When to retry (for failed webhooks)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([webhookId, createdAt])
  @@index([status, retryAt])
}

model Contact {
  id          String  @id @default(cuid())
  name        String
  email       String?
  phone       String?
  source      String  @default("form")
  notes       String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  bookings        Booking[]
  conversation    Conversation?
  formSubmissions FormSubmission[]
  voiceCalls      VoiceCall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, workspaceId])
}

model Service {
  id          String  @id @default(cuid())
  name        String
  description String?
  duration    Int     // in minutes
  price       Float   @default(0.0)
  location    String?
  isActive    Boolean @default(true)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  availableDays String @default("1,2,3,4,5")
  startTime     String @default("09:00")
  endTime       String @default("17:00")

  bookings    Booking[]
  linkedForms IntakeForm[]
  inventoryLinks ServiceInventoryLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id          String        @id @default(cuid())
  date        DateTime
  endTime     DateTime
  status      BookingStatus @default(PENDING)
  notes       String?
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id])
  contactId   String
  contact     Contact       @relation(fields: [contactId], references: [id])
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])

  // Google Calendar sync
  googleCalendarEventId String?

  formSubmissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactForm {
  id             String  @id @default(cuid())
  name           String
  fields         String  @default("[]")
  isActive       Boolean @default(true)
  slug           String  @unique @default(cuid())
  welcomeMessage String?
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntakeForm {
  id          String  @id @default(cuid())
  name        String
  description String?
  fields      String  @default("[]")
  documents   String  @default("[]") // JSON: [{ name, url }]
  isActive    Boolean @default(true)
  slug        String  @unique @default(cuid())
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  submissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormSubmission {
  id           String     @id @default(cuid())
  data         String     @default("{}")
  status       FormStatus @default(PENDING)
  intakeFormId String?
  intakeForm   IntakeForm? @relation(fields: [intakeFormId], references: [id])
  contactId    String
  contact      Contact    @relation(fields: [contactId], references: [id])
  bookingId    String?
  booking      Booking?   @relation(fields: [bookingId], references: [id])
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id])

  sentAt      DateTime?
  completedAt DateTime?
  dueDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  quantity    Int     @default(0)
  threshold   Int     @default(5)
  unit        String  @default("units")
  vendorName  String?
  vendorEmail String?
  vendorPhone String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  serviceLinks ServiceInventoryLink[]
  logs         InventoryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryLog {
  id            String        @id @default(cuid())
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id])
  previousQty   Int
  newQty        Int
  change        Int
  reason        String        // "booking_completed", "manual_adjustment", "restock", "initial"
  referenceId   String?       // bookingId or manual entry id
  referenceType String?       // "booking", "manual", "system"
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([itemId, createdAt])
  @@index([workspaceId, createdAt])
}

model ServiceInventoryLink {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id])
  inventoryId String
  inventory   InventoryItem @relation(fields: [inventoryId], references: [id])
  quantity    Int     @default(1)

  createdAt DateTime @default(now())

  @@unique([serviceId, inventoryId])
}

model Conversation {
  id            String    @id @default(cuid())
  subject       String?
  isActive      Boolean   @default(true)
  lastMessageAt DateTime  @default(now())
  autoResumeAt  DateTime? // When to auto-resume automation after staff reply
  unreadCount   Int       @default(0)
  contactId     String   @unique
  contact       Contact  @relation(fields: [contactId], references: [id])
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id             String           @id @default(cuid())
  content        String
  channel        MessageChannel   @default(EMAIL)
  direction      MessageDirection @default(OUTBOUND)
  status         MessageStatus    @default(SENT)
  isAutomated    Boolean          @default(false)
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  senderId       String?
  sender         User?            @relation(fields: [senderId], references: [id])

  createdAt DateTime @default(now())
}

model AutomationRule {
  id              String            @id @default(cuid())
  name            String
  trigger         AutomationTrigger
  isActive        Boolean           @default(true)
  messageTemplate String?
  delayMinutes    Int               @default(0)
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id])

  logs AutomationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationLog {
  id        String  @id @default(cuid())
  ruleId    String
  rule      AutomationRule @relation(fields: [ruleId], references: [id])
  trigger   String
  status    String  @default("SUCCESS") // SUCCESS, FAILED, SKIPPED
  details   String? // JSON string with execution details
  recipient String? // Email/phone of recipient

  createdAt DateTime @default(now())
}

model Alert {
  id        String  @id @default(cuid())
  type      String
  title     String
  message   String
  isRead    Boolean @default(false)
  actionUrl String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
}

model IntegrationLog {
  id          String    @id @default(cuid())
  type        String    // "email", "sms", "webhook", "calendar"
  status      String    // "success", "failed", "bounced"
  to          String?
  message     String?
  error       String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())
}

// ──── Voice AI (VAPI) Models ────

model VoiceCall {
  id              String    @id @default(cuid())
  callSid         String?   @unique  // VAPI Call SID
  direction       String    // INBOUND | OUTBOUND
  status          String    // INITIATED, RINGING, IN_PROGRESS, COMPLETED, FAILED, NO_ANSWER, BUSY
  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id])
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  
  // Call details
  duration        Int?      // seconds
  recordingUrl    String?
  transcript      String?
  cost            Float?
  startedAt       DateTime?
  endedAt         DateTime?
  
  // AI Agent details
  assistantId     String?   // VAPI Assistant ID
  summary         String?   // AI-generated call summary
  outcome         String?   // CALL_BACK, BOOKING_CREATED, INFO_PROVIDED, TRANSFERRED, etc.
  
  // Metadata
  metadata        String?   // JSON string with additional data
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([contactId])
  @@index([callSid])
}

model VoiceAgent {
  id              String    @id @default(cuid())
  name            String
  description     String?
  isActive        Boolean   @default(true)
  
  // VAPI Configuration
  vapiAssistantId String?   // VAPI assistant ID
  prompt          String?   // System prompt for the AI
  voiceId         String?   // Voice provider ID (e.g., ElevenLabs)
  
  // Capabilities
  canBook         Boolean   @default(false)
  canCheckStatus Boolean   @default(false)
  canTransfer     Boolean   @default(false)
  canHandleInquiry Boolean @default(true)
  
  // Tool configuration (JSON)
  tools           String?   // JSON array of enabled tools
  
  // Greeting
  greeting        String?   // Initial greeting message
  
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  
  phoneNumbers    PhoneNumber[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([workspaceId])
}

model PhoneNumber {
  id              String    @id @default(cuid())
  phoneNumber     String    @unique
  label           String?   // e.g., "Main Line", "Booking Line"
  
  // VAPI Configuration
  vapiPhoneId     String?   // VAPI phone number ID
  isActive        Boolean   @default(true)
  
  // Forwarding
  forwardToStaff  Boolean   @default(false)
  forwardNumber   String?   // If not using VAPI assistant
  
  // Voice Agent assignment
  voiceAgentId    String?
  voiceAgent      VoiceAgent? @relation(fields: [voiceAgentId], references: [id])
  
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
}

// ──── AI Preferences (Per Workspace) ────

model AIPreferences {
  id                          String    @id @default(cuid())
  workspaceId                 String    @unique
  workspace                   Workspace @relation(fields: [workspaceId], references: [id])
  
  // Feature toggles
  smartReplyEnabled           Boolean   @default(true)
  insightsEnabled             Boolean   @default(true)
  voiceEnabled                Boolean   @default(false)
  anomalyDetectionEnabled     Boolean   @default(true)
  inventoryForecastEnabled    Boolean   @default(true)
  autoClassifyEnabled        Boolean   @default(true)
  
  // Preferences
  defaultReplyTone            String    @default("professional") // professional, friendly, casual
  
  // Notification preferences
  alertOnAnomaly              Boolean   @default(true)
  dailyInsightTime           String?   // "09:00"
  
  // Model preferences
  geminiModel                String    @default("gemini-2.0-flash")
  
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}
