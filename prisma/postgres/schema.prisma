generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String
  passwordHash       String
  role               String          @default("STAFF")
  workspaceId        String?
  otpCode            String?
  otpExpires         DateTime?
  otpChannel         String?
  emailVerified      DateTime?
  googleId           String?         @unique
  phone              String?
  phoneVerified      DateTime?
  canAccessInbox     Boolean         @default(true)
  canAccessBookings  Boolean         @default(true)
  canAccessForms     Boolean         @default(true)
  canAccessInventory Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  messages           Message[]
  schedule           StaffSchedule[]
  assignedBookings   Booking[]       @relation("AssignedStaff")
  workspace          Workspace?      @relation(fields: [workspaceId], references: [id])
}

model Workspace {
  id                         String                @id @default(cuid())
  name                       String
  address                    String?
  timezone                   String                @default("UTC")
  contactEmail               String?
  contactPhone               String?
  status                     String                @default("ONBOARDING")
  onboardingStep             Int                   @default(1)
  emailProvider              String?
  emailApiKey                String?
  emailFromName              String?
  emailFromAddress           String?
  emailConfigured            Boolean               @default(false)
  smsProvider                String?
  smsApiKey                  String?
  smsFromNumber              String?
  smsConfigured              Boolean               @default(false)
  whatsappProvider           String?
  whatsappIntegratedNumber   String?
  whatsappConfigured         Boolean               @default(false)
  googleCalendarConnected    Boolean               @default(false)
  googleCalendarAccessToken  String?
  googleCalendarRefreshToken String?
  googleCalendarTokenExpiry  DateTime?
  googleCalendarEmail        String?
  googleCalendarId           String?               @default("primary")
  twilioSubaccountSid        String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  aiPreferences              AIPreferences?
  alerts                     Alert[]
  automationRules            AutomationRule[]
  bookings                   Booking[]
  complianceDocuments        ComplianceDocument[]
  contacts                   Contact[]
  contactForms               ContactForm[]
  conversations              Conversation[]
  doNotCallEntries           DoNotCallEntry[]
  formSubmissions            FormSubmission[]
  intakeForms                IntakeForm[]
  integrationLogs            IntegrationLog[]
  inventoryItems             InventoryItem[]
  inventoryLogs              InventoryLog[]
  phoneNumbers               PhoneNumber[]
  services                   Service[]
  users                      User[]
  voiceAgents                VoiceAgent[]
  voiceCalls                 VoiceCall[]
  webhooks                   Webhook[]
  webhookDeliveries          WebhookDeliveryLog[]
  webhookJobs                WebhookJob[]
  subscription               Subscription?
  usageRecords               UsageRecord[]
  platformPhoneNumbers       PlatformPhoneNumber[]
}

model Webhook {
  id          String               @id @default(cuid())
  url         String
  event       String
  secret      String?
  isActive    Boolean              @default(true)
  workspaceId String
  createdAt   DateTime             @default(now())
  workspace   Workspace            @relation(fields: [workspaceId], references: [id])
  deliveries  WebhookDeliveryLog[]
}

model WebhookDeliveryLog {
  id           String    @id @default(cuid())
  webhookId    String
  status       String
  statusCode   Int?
  responseBody String?
  error        String?
  requestBody  String?
  signature    String?
  retryCount   Int       @default(0)
  retryAt      DateTime?
  workspaceId  String
  createdAt    DateTime  @default(now())
  webhook      Webhook   @relation(fields: [webhookId], references: [id])
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@index([webhookId, createdAt])
  @@index([status, retryAt])
}

model Contact {
  id              String           @id @default(cuid())
  name            String
  email           String?
  phone           String?
  source          String           @default("form")
  notes           String?
  workspaceId     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bookings        Booking[]
  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  conversation    Conversation?
  formSubmissions FormSubmission[]
  voiceCalls      VoiceCall[]

  @@unique([email, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([phone])
}

model Service {
  id             String                 @id @default(cuid())
  name           String
  description    String?
  duration       Int
  price          Float                  @default(0.0)
  location       String?
  isActive       Boolean                @default(true)
  workspaceId    String
  availableDays  String                 @default("1,2,3,4,5")
  startTime      String                 @default("09:00")
  endTime        String                 @default("17:00")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  bookings       Booking[]
  linkedForms    IntakeForm[]
  workspace      Workspace              @relation(fields: [workspaceId], references: [id])
  inventoryLinks ServiceInventoryLink[]
}

model Booking {
  id                    String           @id @default(cuid())
  date                  DateTime
  endTime               DateTime
  status                String           @default("PENDING")
  notes                 String?
  serviceId             String
  contactId             String
  staffId               String?
  workspaceId           String
  googleCalendarEventId String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  contact               Contact          @relation(fields: [contactId], references: [id])
  service               Service          @relation(fields: [serviceId], references: [id])
  staff                 User?            @relation("AssignedStaff", fields: [staffId], references: [id])
  workspace             Workspace        @relation(fields: [workspaceId], references: [id])
  formSubmissions       FormSubmission[]

  @@index([workspaceId, date])
  @@index([workspaceId, status])
  @@index([workspaceId, date, status])
}

model ContactForm {
  id             String    @id @default(cuid())
  name           String
  fields         String    @default("[]")
  isActive       Boolean   @default(true)
  slug           String    @unique @default(cuid())
  welcomeMessage String?
  workspaceId    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
}

model IntakeForm {
  id          String           @id @default(cuid())
  name        String
  description String?
  fields      String           @default("[]")
  documents   String           @default("[]")
  isActive    Boolean          @default(true)
  slug        String           @unique @default(cuid())
  serviceId   String?
  workspaceId String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submissions FormSubmission[]
  service     Service?         @relation(fields: [serviceId], references: [id])
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
}

model FormSubmission {
  id           String      @id @default(cuid())
  data         String      @default("{}")
  status       String      @default("PENDING")
  intakeFormId String?
  contactId    String
  bookingId    String?
  workspaceId  String
  sentAt       DateTime?
  completedAt  DateTime?
  dueDate      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  booking      Booking?    @relation(fields: [bookingId], references: [id])
  contact      Contact     @relation(fields: [contactId], references: [id])
  intakeForm   IntakeForm? @relation(fields: [intakeFormId], references: [id])
  workspace    Workspace   @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
}

model InventoryItem {
  id           String                 @id @default(cuid())
  name         String
  description  String?
  quantity     Int                    @default(0)
  threshold    Int                    @default(5)
  unit         String                 @default("units")
  vendorName   String?
  vendorEmail  String?
  vendorPhone  String?
  workspaceId  String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  workspace    Workspace              @relation(fields: [workspaceId], references: [id])
  logs         InventoryLog[]
  serviceLinks ServiceInventoryLink[]
}

model InventoryLog {
  id            String        @id @default(cuid())
  itemId        String
  previousQty   Int
  newQty        Int
  change        Int
  reason        String
  referenceId   String?
  referenceType String?
  workspaceId   String
  createdAt     DateTime      @default(now())
  item          InventoryItem @relation(fields: [itemId], references: [id])
  workspace     Workspace     @relation(fields: [workspaceId], references: [id])

  @@index([itemId, createdAt])
  @@index([workspaceId, createdAt])
}

model ServiceInventoryLink {
  id          String        @id @default(cuid())
  serviceId   String
  inventoryId String
  quantity    Int           @default(1)
  createdAt   DateTime      @default(now())
  inventory   InventoryItem @relation(fields: [inventoryId], references: [id])
  service     Service       @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, inventoryId])
}

model Conversation {
  id            String    @id @default(cuid())
  subject       String?
  isActive      Boolean   @default(true)
  lastMessageAt DateTime  @default(now())
  autoResumeAt  DateTime?
  unreadCount   Int       @default(0)
  contactId     String    @unique
  workspaceId   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  contact       Contact   @relation(fields: [contactId], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  messages      Message[]
}

model Message {
  id             String       @id @default(cuid())
  content        String
  channel        String       @default("EMAIL")
  direction      String       @default("OUTBOUND")
  status         String       @default("SENT")
  isAutomated    Boolean      @default(false)
  conversationId String
  senderId       String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User?        @relation(fields: [senderId], references: [id])
}

model AutomationRule {
  id              String          @id @default(cuid())
  name            String
  trigger         String
  isActive        Boolean         @default(true)
  messageTemplate String?
  delayMinutes    Int             @default(0)
  workspaceId     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  logs            AutomationLog[]
  workspace       Workspace       @relation(fields: [workspaceId], references: [id])
}

model AutomationLog {
  id        String         @id @default(cuid())
  ruleId    String
  trigger   String
  status    String         @default("SUCCESS")
  details   String?
  recipient String?
  createdAt DateTime       @default(now())
  rule      AutomationRule @relation(fields: [ruleId], references: [id])
}

model Alert {
  id          String    @id @default(cuid())
  type        String
  title       String
  message     String
  isRead      Boolean   @default(false)
  actionUrl   String?
  workspaceId String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model IntegrationLog {
  id          String    @id @default(cuid())
  type        String
  status      String
  to          String?
  message     String?
  error       String?
  workspaceId String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model VoiceCall {
  id               String       @id @default(cuid())
  callSid          String?      @unique
  direction        String
  status           String
  contactId        String?
  workspaceId      String
  duration         Int?
  recordingUrl     String?
  transcript       String?
  cost             Float?
  startedAt        DateTime?
  endedAt          DateTime?
  assistantId      String?
  summary          String?
  outcome          String?
  metadata         String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  escalated        Boolean      @default(false)
  escalationReason String?
  transferredTo    String?
  consent          CallConsent?
  contact          Contact?     @relation(fields: [contactId], references: [id])
  workspace        Workspace    @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status])
  @@index([contactId])
  @@index([callSid])
}

model VoiceAgent {
  id               String        @id @default(cuid())
  name             String
  description      String?
  isActive         Boolean       @default(true)
  vapiAssistantId  String?
  prompt           String?
  voiceId          String?
  canBook          Boolean       @default(false)
  canCheckStatus   Boolean       @default(false)
  canTransfer      Boolean       @default(false)
  canHandleInquiry Boolean       @default(true)
  tools            String?
  greeting         String?
  workspaceId      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  phoneNumbers     PhoneNumber[]
  workspace        Workspace     @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model PhoneNumber {
  id             String      @id @default(cuid())
  phoneNumber    String      @unique
  label          String?
  vapiPhoneId    String?
  twilioPhoneSid String?
  isActive       Boolean     @default(true)
  forwardToStaff Boolean     @default(false)
  forwardNumber  String?
  monthlyFee     Float       @default(150)
  country        String      @default("US")
  numberType     String      @default("local")
  voiceAgentId   String?
  workspaceId    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  voiceAgent     VoiceAgent? @relation(fields: [voiceAgentId], references: [id])
  workspace      Workspace   @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model CallConsent {
  id              String    @id @default(cuid())
  voiceCallId     String    @unique
  consentText     String
  consentResponse Boolean
  capturedAt      DateTime  @default(now())
  channel         String    @default("voice")
  notes           String?
  createdAt       DateTime  @default(now())
  voiceCall       VoiceCall @relation(fields: [voiceCallId], references: [id])

  @@index([voiceCallId])
  @@index([capturedAt])
}

model DoNotCallEntry {
  id          String    @id @default(cuid())
  phoneNumber String
  workspaceId String
  source      String    @default("customer_request")
  reason      String?
  addedBy     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, phoneNumber])
  @@index([phoneNumber])
  @@index([workspaceId, isActive])
}

model WebhookJob {
  id          String    @id @default(cuid())
  type        String
  callId      String
  callSid     String
  workspaceId String
  payload     String
  metadata    String    @default("{}")
  status      String    @default("pending")
  retryCount  Int       @default(0)
  error       String?
  nextRetryAt DateTime?
  processedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([status, nextRetryAt])
  @@index([workspaceId, createdAt])
  @@index([callSid])
}

model AIPreferences {
  id                       String    @id @default(cuid())
  workspaceId              String    @unique
  smartReplyEnabled        Boolean   @default(true)
  insightsEnabled          Boolean   @default(true)
  voiceEnabled             Boolean   @default(false)
  anomalyDetectionEnabled  Boolean   @default(true)
  inventoryForecastEnabled Boolean   @default(true)
  autoClassifyEnabled      Boolean   @default(true)
  defaultReplyTone         String    @default("professional")
  alertOnAnomaly           Boolean   @default(true)
  dailyInsightTime         String?
  geminiModel              String    @default("gemini-2.5-flash-lite")
  voiceModel               String    @default("gemini-2.5-flash-native-audio")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  workspace                Workspace @relation(fields: [workspaceId], references: [id])
}

model Subscription {
  id                     String    @id @default(cuid())
  workspaceId            String    @unique
  razorpaySubscriptionId String?   @unique
  razorpayPlanId         String?
  razorpayCustomerId     String?
  planKey                String    @default("free")
  status                 String    @default("active")
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  lastPaymentAt          DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  workspace              Workspace @relation(fields: [workspaceId], references: [id])

  @@index([razorpayCustomerId])
  @@index([status])
}

model UsageRecord {
  id          String    @id @default(cuid())
  workspaceId String
  category    String
  quantity    Int       @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, category, periodStart])
  @@index([workspaceId, periodStart])
}

model PlatformPhoneNumber {
  id             String     @id @default(cuid())
  phoneNumber    String     @unique
  vapiPhoneId    String?
  twilioPhoneSid String?
  status         String     @default("available")
  workspaceId    String?
  monthlyFee     Float      @default(150)
  country        String     @default("IN")
  assignedAt     DateTime?
  createdAt      DateTime   @default(now())
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([status])
  @@index([workspaceId])
}

model ComplianceDocument {
  id           String    @id @default(cuid())
  workspaceId  String
  documentType String
  fileName     String
  fileUrl      String
  status       String    @default("PENDING")
  reviewedAt   DateTime?
  reviewedBy   String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status])
  @@index([documentType])
}

model StaffSchedule {
  id          String  @id @default(cuid())
  userId      String
  dayOfWeek   Int
  startTime   String  @default("09:00")
  endTime     String  @default("17:00")
  isAvailable Boolean @default(true)
  user        User    @relation(fields: [userId], references: [id])

  @@unique([userId, dayOfWeek])
}
