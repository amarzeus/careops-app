{
  "name": "careops-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_PUBLIC_APP_URL=http://localhost:${PORT:-3000} next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "prebuild": "npm install --include=dev",
    "build": "prisma generate --schema=prisma/postgres/schema.prisma && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-10000}",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "db:migrate": "prisma migrate dev --schema=prisma/postgres/schema.prisma",
    "db:push": "prisma db push --accept-data-loss --schema=prisma/postgres/schema.prisma",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:sqlite:push": "prisma db push --schema=prisma/sqlite/schema.prisma",
    "db:sqlite:generate": "prisma generate --schema=prisma/sqlite/schema.prisma",
    "db:sqlite:seed": "npm run db:seed",
    "test": "npm run test:maintenance",
    "unit": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test:audit": "npm audit --audit-level=critical",
    "test:maintenance": "npm run lint && npm run type-check && npm run format:check && npm run test:unit && npm run build && npm run test:e2e && npm run render:validate && npm run test:audit && npx tsx scripts/print-summary.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "render": "bash ./scripts/render-cli.sh",
    "render:validate": "bash ./scripts/render-cli.sh blueprints validate render.yaml --output json"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^7.0.9",
    "@types/uuid": "^10.0.0",
    "@vapi-ai/server-sdk": "^0.11.0",
    "@vapi-ai/web": "^2.5.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.34.0",
    "lru-cache": "^11.2.6",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.1",
    "prisma": "6.2.1",
    "razorpay": "^2.9.6",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0",
    "twilio": "^5.12.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.33",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.2.4",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-jsdoc": "^62.5.4",
    "jsdom": "^28.0.0",
    "pg": "^8.18.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vercel": "^28.18.5",
    "vitest": "^4.0.18"
  }
}
